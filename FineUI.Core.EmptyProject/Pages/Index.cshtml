@page
@model FineUI.Core.EmptyProject.Pages.IndexModel
@{
    ViewBag.Title = "首页";
    var F = @Html.F();
}

@section head {

    <link type="text/css" rel="stylesheet" href="~/res/css/index.css" />

    @* 欢迎页样式与公开的 FineUI.Core RazorForms 默认示例保持一致 *@
    <style>
        .intro { max-width: 920px; margin: 0 auto; padding: 32px 24px 48px; color: var(--f-content-text-color); font-size: 14px; line-height: 1.7; }

        .position { max-width: 840px; margin: 28px auto 4px; text-align: center; }
        .position .headline { margin: 0; font-size: 24px; font-weight: 700; line-height: 1.5; letter-spacing: .2px; }
        .position .headline-detail { display: inline-block; margin-top: 2px; color: var(--f-content-text-color); font-size: 20px; font-weight: 600; }
        .position p { max-width: 760px; margin: 16px auto 0; color: var(--f-content-text-color); opacity: .72; }

        .capability-head { margin: 48px auto 0; text-align: center; }
        .capability-head h2 { margin: 0; color: var(--f-content-text-color); font-size: 24px; font-weight: 700; letter-spacing: .2px; }
        .capability-head p { margin: 0; color: var(--f-content-text-color); opacity: .65; }

        .features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 30px 0 8px; }
        .feature { min-width: 0; padding: 20px 22px; border: 1px solid var(--f-content-border-color); border-radius: 12px; background: var(--f-content-background-color); box-shadow: 0 2px 12px rgba(20, 40, 55, .04); }
        .feature .ico { font-size: 24px; line-height: 1; }
        .feature h3 { margin: 10px 0 6px; color: var(--f-content-text-color); font-size: 16px; }
        .feature p { margin: 0; color: var(--f-content-text-color); font-size: 13px; opacity: .72; }

        .demo { margin: 40px 0 8px; }
        .demo .demo-title { margin-bottom: 14px; color: var(--f-content-text-color); font-size: 13px; text-align: center; opacity: .55; }
        .demo .code { padding: 18px 22px; overflow-x: auto; border: 1px solid var(--f-content-border-color); border-radius: 10px; background: #1e2a30; }
        .demo pre { margin: 0; color: #cfe3dc; font: 13px/1.75 Consolas, 'Courier New', monospace; white-space: pre; }
        .demo .cap { margin-top: 12px; color: var(--f-content-text-color); font-size: 12px; text-align: center; opacity: .55; }
        .k { color: #6fb3d2; }
        .a { color: #b3d78c; }
        .s { color: #e0a978; }
        .c { color: #7c8b93; }

        .foot { margin-top: 36px; color: var(--f-content-text-color); font-size: 13px; text-align: center; opacity: .55; }

        @@media (max-width: 640px) {
            .intro { padding: 24px 16px 36px; }
            .position { margin-top: 24px; }
            .position .headline { font-size: 20px; }
            .position .headline-detail { font-size: 17px; }
            .features { grid-template-columns: 1fr; }
        }
    </style>

}

@section body {

    <div id="maincontent">
        <div class="intro">
            <div class="position">
                <h2 class="headline">FineUI.Core<br /><span class="headline-detail">「AI 友好 · 标签式 · 有状态」企业级全栈 UI 框架</span></h2>
            </div>

            <div class="capability-head">
                <p>AI 写得快，人类看得懂；一个标签一个控件，一个属性一个功能；事件直达后端，后端修改属性自动回传前端。</p>
            </div>

            <div class="features">
                <div class="feature">
                    <div class="ico">🏷️</div>
                    <h3>标签式声明</h3>
                    <p>一个标签一个控件，一个属性一个功能，所写即所得——页面结构一眼可读、可维护。</p>
                </div>
                <div class="feature">
                    <div class="ico">🔄</div>
                    <h3>状态自动往返</h3>
                    <p>控件状态在前后端之间自动保持——后端直接读写控件属性、事件直达处理方法，像写桌面程序一样写 Web。</p>
                </div>
                <div class="feature">
                    <div class="ico">🤖</div>
                    <h3>AI 友好</h3>
                    <p>所有控件都遵循同一套声明式标签规范——AI 好生成，人也看得懂。</p>
                </div>
                <div class="feature">
                    <div class="ico">⚙️</div>
                    <h3>ASP.NET Core 全栈</h3>
                    <p>一个依赖即可接入，不碰 JavaScript、无需前后端分离；控件状态不绑定单台服务器，天然支持水平扩展。</p>
                </div>
            </div>

            <div class="demo">
                <div class="demo-title">— Razor 页面写标签，后端写事件方法 —</div>
                <div class="code">
<pre><span class="c">&lt;!-- 页面：一个标签一个控件 --&gt;</span>
<span class="k">&lt;f:SimpleForm</span> <span class="a">ID</span>=<span class="s">"SimpleForm1"</span><span class="k">&gt;</span>
    <span class="k">&lt;f:TextBox</span> <span class="a">ID</span>=<span class="s">"tbxUser"</span> <span class="a">Label</span>=<span class="s">"用户名"</span><span class="k">&gt;&lt;/f:TextBox&gt;</span>
    <span class="k">&lt;f:Button</span> <span class="a">ID</span>=<span class="s">"btnLogin"</span> <span class="a">Text</span>=<span class="s">"登录"</span> <span class="a">OnClick</span>=<span class="s">"btnLogin_Click"</span><span class="k">&gt;&lt;/f:Button&gt;</span>
    <span class="k">&lt;f:Label</span> <span class="a">ID</span>=<span class="s">"lblHi"</span><span class="k">&gt;&lt;/f:Label&gt;</span>
<span class="k">&lt;/f:SimpleForm&gt;</span>

<span class="c">// 后端：事件里直接读写控件状态，自动同步到前端</span>
<span class="k">protected void</span> btnLogin_Click(object sender, EventArgs e) {
    var user = tbxUser.Text;                 <span class="c">// 读控件状态</span>
    lblHi.Text = <span class="s">"你好，"</span> + user;        <span class="c">// 写控件状态 → 自动回传前端</span>
}</pre>
                </div>
                <div class="cap">状态自动往返、事件直达后端——不写一行 JavaScript。</div>
            </div>

            <div class="foot">← 从左侧菜单选择页面，将在此工作区以选项卡打开</div>
        </div>
    </div>


    <f:Panel ID="mainPanel" Layout="Region" CssClass="mainpanel" ShowBorder="false" ShowHeader="false" IsViewPort="true">
        <Items>
            <f:Panel ID="sidebarRegion" CssClass="sidebarregion" RegionPosition="Left" ShowBorder="false" Width="260" ShowHeader="false"
                     EnableCollapse="false" Collapsed="false" Layout="VBox" RegionSplit="true" RegionSplitIcon="false" RegionSplitWidth="3" RegionSplitTransparent="true">
                <Items>
                    <f:ContentPanel ID="sideheaderTopPanel" CssClass="topregion" ShowBorder="false" ShowHeader="false">
                        <div id="sideheader" class="f-widget-header f-mainheader">
                            <a class="logo" href="@Url.Content("~/")" title="FineUI.Core空项目">FineUI.Core空项目</a>
                            <div class="logo-subtitle">RazorForms</div>
                        </div>
                    </f:ContentPanel>
                    <f:Panel ID="leftPanel" CssClass="leftregion" BoxFlex="1" ShowBorder="false" ShowHeader="false" Layout="Fit">
                        <Items>
                            <f:Tree ID="treeMenu" ShowBorder="false" ShowHeader="false" HideHScrollbar="true" HideVScrollbar="true" ExpanderToRight="true" HeaderStyle="true" AllHeaderStyle="true">
                                <Nodes>
                                    <f:TreeNode Text="默认分类" Expanded="true">
                                        <f:TreeNode Text="开始页面" NavigateUrl="@Url.Content("~/Hello")"></f:TreeNode>
                                        <f:TreeNode Text="登录页面" NavigateUrl="@Url.Content("~/Login")"></f:TreeNode>
                                    </f:TreeNode>
                                </Nodes>
                            </f:Tree>
                        </Items>
                    </f:Panel>
                </Items>
            </f:Panel>
            <f:Panel ID="bodyRegion" CssClass="bodyregion" RegionPosition="Center" ShowBorder="false" ShowHeader="false" Layout="VBox">
                <Items>
                    <f:ContentPanel ID="topPanel" CssClass="topregion" ShowBorder="false" ShowHeader="false">
                        <div id="header" class="f-widget-header f-mainheader">
                            <div class="header-left">

                            </div>
                            <div class="header-right">
                                <f:Button ID="btnThemeSelect" EnableDefaultCorner="false" EnableDefaultState="false" IconFont="_Skin" IconAlign="Top" CssClass="icononlyaction themes" ToolTip="主题仓库" ClickHandler="onThemeSelectClick"></f:Button>
                                <f:Button EnableDefaultCorner="false" EnableDefaultState="false" IconUrl="@Url.Content("~/res/images/my_face_80.jpg")" IconAlign="Left" CssClass="userpicaction" Text="三生石上">
                                    <Menu>
                                        <Items>
                                            <f:MenuButton IconFont="_User" Text="个人信息" ClickHandler="onUserProfileClick">
                                            </f:MenuButton>
                                            <f:MenuButton IconFont="_SignOut" Text="安全退出" ClickHandler="onSignOutClick">
                                            </f:MenuButton>
                                        </Items>
                                    </Menu>
                                </f:Button>
                            </div>
                        </div>
                    </f:ContentPanel>
                    <f:TabStrip ID="mainTabStrip" CssClass="centerregion" ShowInkBar="true" InkBarPosition="Bottom" BoxFlex="1" ShowBorder="true" EnableTabCloseMenu="true">
                        <Tabs>
                            <f:Tab ID="tabHomepage" Title="首页" IconFont="_Home" EnableIFrame="false" BodyPadding="10" ContentEl="#maincontent">
                            </f:Tab>
                        </Tabs>
                    </f:TabStrip>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>

    <f:Window ID="windowThemeRoller" Hidden="true" EnableResize="true" EnableMaximize="true" EnableClose="true" Height="600" Width="850"
              IsModal="true" ClearIFrameAfterClose="false" IFrameUrl="@Url.Content("~/Themes")" EnableIFrame="true" Title="主题仓库"></f:Window>

    @{
        
    }

}

@section script {

    <script>

        // 点击主题仓库
        function onThemeSelectClick(event) {
            F.ui.windowThemeRoller.show();
        }

        // 点击「个人信息」
        function onUserProfileClick(event) {
            F.alert('尚未实现');
        }

        // 点击「安全退出」
        function onSignOutClick(event) {
            F.alert('尚未实现');
        }

        // 通知框
        function notify(msg) {
            F.notify({
                message: msg,
                messageIcon: 'information',
                target: '_top',
                header: false,
                displayMilliseconds: 3 * 1000,
                positionX: 'center',
                positionY: 'center'
            });
        }

        // 页面控件初始化完毕后，会调用用户自定义的onReady函数
        F.ready(function () {

            if (!F.ui.treeMenu) return;


            // 初始化主框架中的树(或者Accordion+Tree)和选项卡互动，以及地址栏的更新
            // treeMenu： 主框架中的树控件实例，或者内嵌树控件的手风琴控件实例
            // mainTabStrip： 选项卡实例
            // options: 参数
            // options.updateHash： 切换Tab时，是否更新地址栏Hash值（默认值：true）
            // options.refreshWhenExist： 添加选项卡时，如果选项卡已经存在，是否刷新内部IFrame（默认值：false）
            // options.refreshWhenTabChange: 切换选项卡时，是否刷新内部IFrame（默认值：false）
            // options.maxTabCount: 最大允许打开的选项卡数量
            // options.maxTabMessage: 超过最大允许打开选项卡数量时的提示信息
            // options.beforeNodeClick: 节点点击事件之前执行（返回false则不执行点击事件）
            // options.beforeTabAdd: 添加选项卡之前执行（返回false则不添加选项卡）
            // options.moveToEnd: 将选项卡移到尾部（如果选项卡已存在，则不改变位置，默认值：false）
            F.initTreeTabStrip(F.ui.treeMenu, F.ui.mainTabStrip, {
                maxTabCount: 10,
                maxTabMessage: '请先关闭一些选项卡（最多允许打开 10 个）！'
            });

        });
    </script>
}
